37830>>>>>>>        Boolean bHasRecord
37830>>>>>>>        Handle hoDD
37830>>>>>>>
37830>>>>>>>        Get Server to hoDD
37831>>>>>>>        Get GetNavigateData to NavigateData
37832>>>>>>>        Get HasRecord of hoDD to bHasRecord
37833>>>>>>>
37833>>>>>>>        // let's hide all buttons and then Show the ones we want
37833>>>>>>>        WebSet pbRender of oEditBtn to False
37834>>>>>>>        WebSet pbRender of oSaveBtn to False
37835>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37836>>>>>>>        WebSet pbRender of oDeleteBtn to False
37837>>>>>>>
37837>>>>>>>        If (NavigateData.bReadOnly) Begin
37839>>>>>>>            WebSet pbRender of oEditBtn to True
37840>>>>>>>        End
37840>>>>>>>>
37840>>>>>>>        Else Begin
37841>>>>>>>            WebSet pbRender of oSaveBtn to True
37842>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37843>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37844>>>>>>>        End
37844>>>>>>>>
37844>>>>>>>    End_Procedure
