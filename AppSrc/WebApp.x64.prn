37848>>>>>>>
37848>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37851>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37851>>>>>>>                Case Break
37852>>>>>>>
37852>>>>>>>            Case Else // must be nfUndefined
37852>>>>>>>
37852>>>>>>>        Case End
37852>>>>>>>
37852>>>>>>>        Send SetActionButtons
37853>>>>>>>
37853>>>>>>>    End_Procedure
