37533>>>>>>>    Procedure SetActionButtons
37536>>>>>>>        tWebNavigateData NavigateData
37536>>>>>>>        tWebNavigateData NavigateData
37536>>>>>>>        Boolean bHasRecord
37536>>>>>>>        Handle hoDD
37536>>>>>>>
37536>>>>>>>        Get Server to hoDD
37537>>>>>>>        Get GetNavigateData to NavigateData
37538>>>>>>>        Get HasRecord of hoDD to bHasRecord
37539>>>>>>>
37539>>>>>>>        // let's hide all buttons and then Show the ones we want
37539>>>>>>>        WebSet pbRender of oEditBtn to False
37540>>>>>>>        WebSet pbRender of oSaveBtn to False
37541>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37542>>>>>>>        WebSet pbRender of oDeleteBtn to False
37543>>>>>>>
37543>>>>>>>        If (NavigateData.bReadOnly) Begin
37545>>>>>>>            WebSet pbRender of oEditBtn to True
37546>>>>>>>        End
37546>>>>>>>>
37546>>>>>>>        Else Begin
37547>>>>>>>            WebSet pbRender of oSaveBtn to True
37548>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37549>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37550>>>>>>>        End
37550>>>>>>>>
37550>>>>>>>    End_Procedure
