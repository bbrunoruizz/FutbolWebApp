37544>>>>>>>
37544>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37547>>>>>>>        Case Begin
37547>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37549>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37549>>>>>>>                Case Break
37550>>>>>>>
37550>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37553>>>>>>>                // If from parent, this is a constrained drill down.
37553>>>>>>>                Case Break
37554>>>>>>>
37554>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37557>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37557>>>>>>>                Case Break
37558>>>>>>>
37558>>>>>>>            Case Else // must be nfUndefined
37558>>>>>>>
37558>>>>>>>        Case End
37558>>>>>>>
37558>>>>>>>        Send SetActionButtons
37559>>>>>>>
37559>>>>>>>    End_Procedure
37560>>>>>>>
37560>>>>>>>End_Object 
