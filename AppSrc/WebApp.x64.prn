37516>>>>>>>    Procedure SetActionButtons
37519>>>>>>>        tWebNavigateData NavigateData
37519>>>>>>>        tWebNavigateData NavigateData
37519>>>>>>>        Boolean bHasRecord
37519>>>>>>>        Handle hoDD
37519>>>>>>>
37519>>>>>>>        Get Server to hoDD
37520>>>>>>>        Get GetNavigateData to NavigateData
37521>>>>>>>        Get HasRecord of hoDD to bHasRecord
37522>>>>>>>
37522>>>>>>>        // let's hide all buttons and then Show the ones we want
37522>>>>>>>        WebSet pbRender of oEditBtn to False
37523>>>>>>>        WebSet pbRender of oSaveBtn to False
37524>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37525>>>>>>>        WebSet pbRender of oDeleteBtn to False
37526>>>>>>>
37526>>>>>>>        If (NavigateData.bReadOnly) Begin
37528>>>>>>>            WebSet pbRender of oEditBtn to True
37529>>>>>>>        End
37529>>>>>>>>
37529>>>>>>>        Else Begin
37530>>>>>>>            WebSet pbRender of oSaveBtn to True
37531>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37532>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37533>>>>>>>        End
37533>>>>>>>>
37533>>>>>>>    End_Procedure
37534>>>>>>>
37534>>>>>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37537>>>>>>>        // Close after save
37537>>>>>>>        Send NavigateClose Self
37538>>>>>>>    End_Procedure
37539>>>>>>>
37539>>>>>>>    // this will close the view after a delete
