38479>>>>>        WebSet pbRender of oNewButton to True
38480>>>>>        WebSet pbRender of oDetailButton to True
38481>>>>>
38481>>>>>        Case Begin
38481>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38483>>>>>                // If from parent, this is a constrained drill down
38483>>>>>                Case Break
38484>>>>>
38484>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38487>>>>>                // If from child, this is a probably a parent lookup from a Zoom
38487>>>>>                Case Break
38488>>>>>
38488>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38491>>>>>                // If from main, this is a probably a main-file lookup from a Zoom
38491>>>>>                WebSet pbRender of oDetailButton to False
38492>>>>>                Case Break
38493>>>>>
38493>>>>>            Case Else // must be nfUndefined
38493>>>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38493>>>>>
38493>>>>>        Case End
38493>>>>>
38493>>>>>    End_Procedure
