37561>>>>>>>
37561>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37564>>>>>>>        Case Begin
37564>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37566>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37566>>>>>>>                Case Break
37567>>>>>>>
37567>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37570>>>>>>>                // If from parent, this is a constrained drill down.
37570>>>>>>>                Case Break
37571>>>>>>>
37571>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37574>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37574>>>>>>>                Case Break
37575>>>>>>>
37575>>>>>>>            Case Else // must be nfUndefined
37575>>>>>>>
37575>>>>>>>        Case End
37575>>>>>>>
37575>>>>>>>        Send SetActionButtons
37576>>>>>>>
37576>>>>>>>    End_Procedure
37577>>>>>>>
37577>>>>>>>End_Object 
